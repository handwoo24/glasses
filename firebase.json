{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": [
    {
      "backendId": "glasses",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".output",
        ".emulator-data",
        "resources",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-debug.log"
      ]
    }
  ],
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8180 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4100 },
    "hub": { "host": "127.0.0.1", "port": 4410 },
    "logging": { "host": "127.0.0.1", "port": 4510 },
    "singleProjectMode": true
  }
}
